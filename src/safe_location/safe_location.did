type LocationData = record {
  latitude  : float64;
  longitude : float64;
  accuracy  : opt float64;
  timestamp : int;
  locationLabel : opt text;
};

type ShareInfo = record {
  token     : text;
  owner     : text;
  recipient : opt text;
  createdAt : int;
  expiresAt : int;
  isActive  : bool;
};

type GeofenceZone = record {
  id           : text;
  owner        : text;
  name         : text;
  centerLat    : float64;
  centerLng    : float64;
  radiusMeters : float64;
  alertOnEnter : bool;
  alertOnExit  : bool;
  createdAt    : int;
  isActive     : bool;
};

type GeofenceAlertType = variant { entered; exited };

type GeofenceAlert = record {
  zoneId    : text;
  zoneName  : text;
  alertType : GeofenceAlertType;
  timestamp : int;
};

type TrustedContact = record {
  id          : text;
  name        : text;
  handle      : text;
  relation    : text;
  permissions : vec text;
};

type SafeSettings = record {
  owner           : text;
  contacts        : vec TrustedContact;
  emergencyMode   : bool;
  defaultDuration : text;
  highAccuracy    : bool;
  shareBattery    : bool;
  updatedAt       : int;
};

type ShareResult = variant { ok : text;         err : text };
type LocResult   = variant { ok : LocationData; err : text };
type VoidResult  = variant { ok;                err : text };
type SettingsResult = variant { ok : SafeSettings; err : text };

service : {
  shareLocation         : (float64, float64, opt float64, nat, opt text, opt text) -> (ShareResult);
  updateSharedLocation  : (text, float64, float64, opt float64)                    -> (VoidResult);
  getSharedLocation     : (text)                                                   -> (LocResult);
  revokeShare           : (text)                                                   -> (VoidResult);
  listMyShares          : ()                                                       -> (vec ShareInfo) query;
  setGeofence           : (text, float64, float64, float64, bool, bool)            -> (ShareResult);
  listMyGeofences       : ()                                                       -> (vec GeofenceZone) query;
  deleteGeofence        : (text)                                                   -> (VoidResult);
  checkGeofences        : (float64, float64)                                       -> (vec GeofenceAlert) query;
  getMySettings         : ()                                                       -> (SettingsResult) query;
  setMySettings         : (vec TrustedContact, bool, text, bool, bool)             -> (SettingsResult);
};

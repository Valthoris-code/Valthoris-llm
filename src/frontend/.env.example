# Valthoris frontend — public build-time configuration
#
# Copy this file to `.env` (or `.env.local`) inside `src/frontend/` and fill in
# the values for your environment:
#
#   cp .env.example .env
#
# IMPORTANT — these variables are read by Vite at BUILD time and are baked into
# the generated bundle. Setting them only on the server that serves `dist/`
# has no effect: the build must be re-run after any change.
#
# Only PUBLIC values belong here. Never put a Supabase service-role key or an
# LLM API key in this file — everything prefixed with `VITE_` is shipped to the
# browser. Server-side secrets live in the Supabase Edge Function secret store
# (see docs/DEPLOYMENT.md).

# --- Supabase (required for the AI Assistant, waiting list and profiles) -----
# Project URL, e.g. https://abcdefghijklmnop.supabase.co
VITE_SUPABASE_URL=
# Public anon key — safe to expose in the browser; access is enforced by RLS.
VITE_SUPABASE_ANON_KEY=

# --- Internet Computer -------------------------------------------------------
# "ic" (mainnet, default) or "local" for a local dfx replica.
VITE_DFX_NETWORK=ic

# Canister IDs. Leave empty to use the mainnet defaults hard-coded in
# src/services/canisterIds.ts. `dfx deploy` writes real values here for local
# development (see `output_env_file` in dfx.json).
VITE_CANISTER_ID_BACKEND=
VITE_CANISTER_ID_COMMUNITY=
VITE_CANISTER_ID_IDENTITY=
VITE_CANISTER_ID_THREAT_INTELLIGENCE=
VITE_CANISTER_ID_SAFE_LOCATION=

# --- Deployment --------------------------------------------------------------
# Base path for the built assets. Defaults to "/" (custom domain).
# Set to "/Valthoris-llm/" when publishing to a GitHub Pages project sub-path.
VITE_BASE_PATH=

type UserProfile = record {
  principal       : text;
  displayName     : text;
  createdAt       : int;
  updatedAt       : int;
  reputationScore : nat;
  totalReports    : nat;
  totalScans      : nat;
  isActive        : bool;
};

type UserRole = variant {
  member;
  moderator;
  administrator;
};

type ManagedUser = record {
  principal    : text;
  displayName  : text;
  role         : UserRole;
  isActive     : bool;
  registeredAt : int;
};

type SystemStats = record {
  totalUsers : nat;
  version    : text;
  startTime  : int;
};

type ProfileResult      = variant { ok : UserProfile; err : text };
type ManagedUserResult  = variant { ok : ManagedUser; err : text };
type ManagedUsersResult = variant { ok : vec ManagedUser; err : text };
type VoidResult         = variant { ok; err : text };

service : {
  ensureManagedUser      : ()      -> (ManagedUserResult);
  listManagedUsers       : ()      -> (ManagedUsersResult);
  setUserRole            : (text, UserRole) -> (ManagedUserResult);
  setUserActive          : (text, bool) -> (ManagedUserResult);
  registerUser           : (text)  -> (ProfileResult);
  getUserProfile         : ()      -> (ProfileResult) query;
  getProfile             : (text)  -> (opt UserProfile) query;
  isRegistered           : ()      -> (bool) query;
  recordScan             : ()      -> (VoidResult);
  recordReport           : ()      -> (VoidResult);
  getSystemStats         : ()      -> (SystemStats) query;
  healthCheck            : ()      -> (bool) query;
  getVersion             : ()      -> (text) query;
};
